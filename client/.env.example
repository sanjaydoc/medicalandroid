# Copy to .env.local (or set in the Cloudflare Pages build env) and fill in.
# Nothing here is secret except the Worker's own server-side keys (those live in
# the Worker, never in the client).

# The chat backend — your NEW Cloudflare Worker's URL (Online mode).
VITE_CHAT_ENDPOINT=https://medai-chat.YOUR-SUBDOMAIN.workers.dev
# Optional same-origin relay (a Pages Function at /api/chat that forwards to the
# Worker). Leave blank to call the Worker directly.
VITE_CHAT_RELAY=

# Your NEW Supabase project (admin dashboard + chat logs + auth).
# The anon/publishable key is frontend-safe; lock it down with INSERT-only RLS.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_KEY=YOUR-ANON-PUBLISHABLE-KEY

# Build HashRouter static bundle (for Cloudflare Pages + the Android app).
VITE_STATIC=true
