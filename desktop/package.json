{
  "name": "meddroid-partners-desktop",
  "productName": "MedDroid Partners",
  "version": "1.0.0",
  "description": "MedDroid Partners — offline hospital-systems console with a local, encrypted database. Partner data stays on the partner's machine.",
  "homepage": "https://medicalandroid.com",
  "author": "MedDroid <support@medicalandroid.com>",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "copy:web": "node scripts/copy-web.mjs",
    "start": "npm run copy:web && electron .",
    "dist": "npm run copy:web && electron-builder --publish never",
    "dist:win": "npm run copy:web && electron-builder --win --publish never",
    "dist:mac": "npm run copy:web && electron-builder --mac --publish never",
    "dist:linux": "npm run copy:web && electron-builder --linux --publish never",
    "publish": "npm run copy:web && electron-builder --publish always"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^11.8.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
