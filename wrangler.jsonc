{
  // Serves the pre-built, committed docs/ folder as a static site (Cloudflare
  // Workers Static Assets). No build step — docs/ is already committed, exactly
  // like the StemCells Cloudflare deploy. `npx wrangler deploy` uploads docs/.
  "name": "medicalandroid",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./docs",
    "not_found_handling": "single-page-application"
  }
}
